<?xml version="1.0" encoding="utf-8"?>
<!-- Thanh tiến trình kiểu YouTube: track mờ, buffer xám, progress đỏ #FF0033 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="@color/yt_progress_track" />
            <corners android:radius="2dp" />
            <size android:height="@dimen/seekbar_height" />
        </shape>
    </item>
    <item android:id="@android:id/secondaryProgress">
        <clip>
            <shape android:shape="rectangle">
                <solid android:color="@color/yt_progress_buffer" />
                <corners android:radius="2dp" />
            </shape>
        </clip>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <solid android:color="@color/yt_accent" />
                <corners android:radius="2dp" />
            </shape>
        </clip>
    </item>
</layer-list>
