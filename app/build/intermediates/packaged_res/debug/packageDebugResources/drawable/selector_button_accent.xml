<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/yt_bg_secondary" />
            <corners android:radius="@dimen/corner_large" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/yt_accent_pressed" />
            <corners android:radius="@dimen/corner_large" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/yt_accent" />
            <corners android:radius="@dimen/corner_large" />
        </shape>
    </item>
</selector>
