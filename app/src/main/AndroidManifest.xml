<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- MediaPlayer.setWakeMode() giữ CPU khi phát Audio-Only màn hình tắt -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name=".YtApplication"
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.YouTube2026">

        <!-- Màn hình chính (Home - Bước 4) -->
        <activity
            android:name=".ui.MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="true"
            android:label="@string/app_name"
            android:windowSoftInputMode="stateHidden|adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Màn hình chẩn đoán tầng mạng & StreamResolver (mở nhanh từ Top Bar của MainActivity) -->
        <activity
            android:name=".ui.NetworkDiagnosticActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="false"
            android:label="@string/diag_title"
            android:windowSoftInputMode="stateHidden|adjustResize" />

    </application>

</manifest>
