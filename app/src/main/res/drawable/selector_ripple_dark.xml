<?xml version="1.0" encoding="utf-8"?>
<!-- Hiệu ứng nhấn cho hàng ListView / vùng bấm (thay ripple trên API 19) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:exitFadeDuration="@android:integer/config_shortAnimTime">
    <item android:drawable="@color/yt_pressed_overlay" android:state_pressed="true" />
    <item android:drawable="@color/yt_pressed_overlay" android:state_focused="true" />
    <item android:drawable="@color/yt_transparent" />
</selector>
