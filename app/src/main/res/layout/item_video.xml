<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/selector_ripple_dark"
    android:orientation="vertical"
    android:paddingBottom="@dimen/space_l"
    android:paddingLeft="@dimen/space_m"
    android:paddingRight="@dimen/space_m"
    android:paddingTop="@dimen/space_s">

    <!-- Khung Thumbnail tỷ lệ 16:9 bo góc 12dp -->
    <com.ytkitkat.app.ui.AspectRatio16x9FrameLayout
        android:id="@+id/thumb_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_thumbnail">

        <ImageView
            android:id="@+id/img_thumbnail"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="fitXY" />

        <!-- Badge thời lượng (08:17) hoặc TRỰC TIẾP ở góc dưới phải -->
        <TextView
            android:id="@+id/txt_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|right"
            android:layout_marginBottom="@dimen/space_s"
            android:layout_marginRight="@dimen/space_s"
            android:background="@drawable/bg_duration_badge"
            android:paddingBottom="2dp"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:paddingTop="2dp"
            android:singleLine="true"
            android:textAppearance="@style/TextAppearance.YouTube2026.Badge" />
    </com.ytkitkat.app.ui.AspectRatio16x9FrameLayout>

    <!-- Hàng thông tin bên dưới: Avatar tròn 36dp + Tiêu đề 2 dòng + Tên kênh • Lượt xem • Thời gian -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_m"
        android:gravity="top"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/img_channel_avatar"
            android:layout_width="@dimen/avatar_size"
            android:layout_height="@dimen/avatar_size"
            android:background="@drawable/bg_avatar_placeholder"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/space_m"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txt_video_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:lineSpacingExtra="2dp"
                android:maxLines="2"
                android:textColor="@color/yt_text_primary"
                android:textSize="@dimen/text_title"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/txt_video_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/yt_text_secondary"
                android:textSize="@dimen/text_meta" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
