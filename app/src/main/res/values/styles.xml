<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ================= THEME (API 19 base, Holo dark) ================= -->
    <style name="Base.Theme.YouTube2026" parent="@android:style/Theme.Holo.NoActionBar">
        <item name="android:windowBackground">@color/yt_bg_primary</item>
        <item name="android:colorBackground">@color/yt_bg_primary</item>
        <item name="android:colorBackgroundCacheHint">@color/yt_bg_primary</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>

        <item name="android:textColorPrimary">@color/yt_text_primary</item>
        <item name="android:textColorSecondary">@color/yt_text_secondary</item>
        <item name="android:textColorTertiary">@color/yt_text_secondary</item>
        <item name="android:textColorHint">@color/yt_text_hint</item>
        <item name="android:textColorHighlight">@color/yt_accent_highlight</item>
        <item name="android:textColorLink">@color/yt_link</item>

        <item name="android:listViewStyle">@style/Widget.YouTube2026.ListView</item>
        <item name="android:editTextStyle">@style/Widget.YouTube2026.EditText</item>
        <item name="android:buttonStyle">@style/Widget.YouTube2026.Button</item>
        <item name="android:seekBarStyle">@style/Widget.YouTube2026.SeekBar</item>
        <item name="android:scrollbarThumbVertical">@drawable/scrollbar_thumb</item>
    </style>

    <style name="Theme.YouTube2026" parent="Base.Theme.YouTube2026" />

    <!-- Theme toàn màn hình cho trình phát (dùng ở Bước 6) -->
    <style name="Theme.YouTube2026.Player" parent="Theme.YouTube2026">
        <item name="android:windowBackground">@android:color/black</item>
    </style>

    <!-- ================= WIDGETS ================= -->
    <style name="Widget.YouTube2026.ListView" parent="@android:style/Widget.Holo.ListView">
        <item name="android:divider">@null</item>
        <item name="android:dividerHeight">0dp</item>
        <item name="android:listSelector">@drawable/selector_ripple_dark</item>
        <item name="android:cacheColorHint">@color/yt_bg_primary</item>
        <item name="android:drawSelectorOnTop">false</item>
        <item name="android:scrollbarStyle">outsideOverlay</item>
        <item name="android:requiresFadingEdge">none</item>
    </style>

    <style name="Widget.YouTube2026.EditText" parent="@android:style/Widget.Holo.EditText">
        <item name="android:background">@drawable/selector_search_box</item>
        <item name="android:textColor">@color/yt_text_primary</item>
        <item name="android:textColorHint">@color/yt_text_hint</item>
        <item name="android:textCursorDrawable">@drawable/edittext_cursor</item>
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:minHeight">@dimen/search_box_height</item>
        <item name="android:paddingLeft">@dimen/space_l</item>
        <item name="android:paddingRight">@dimen/space_l</item>
        <item name="android:paddingTop">@dimen/space_s</item>
        <item name="android:paddingBottom">@dimen/space_s</item>
    </style>

    <!-- Nút mặc định: nền #272727 (tonal) -->
    <style name="Widget.YouTube2026.Button" parent="@android:style/Widget.Holo.Button">
        <item name="android:background">@drawable/selector_button_tonal</item>
        <item name="android:textColor">@color/yt_text_primary</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:minWidth">64dp</item>
        <item name="android:paddingLeft">@dimen/space_l</item>
        <item name="android:paddingRight">@dimen/space_l</item>
        <item name="android:gravity">center</item>
    </style>

    <!-- Nút chính: nền sáng #F1F1F1, chữ tối (kiểu nút "Đăng ký") -->
    <style name="Widget.YouTube2026.Button.Primary">
        <item name="android:background">@drawable/selector_button_primary</item>
        <item name="android:textColor">@color/yt_bg_primary</item>
    </style>

    <!-- Nút nhấn mạnh: nền đỏ #FF0033 -->
    <style name="Widget.YouTube2026.Button.Accent">
        <item name="android:background">@drawable/selector_button_accent</item>
        <item name="android:textColor">@color/yt_text_primary</item>
    </style>

    <!-- Chip lọc (Tất cả / Âm nhạc / Trò chơi ...) -->
    <style name="Widget.YouTube2026.Chip" parent="@android:style/Widget.Holo.TextView">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">@dimen/chip_height</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingLeft">@dimen/space_m</item>
        <item name="android:paddingRight">@dimen/space_m</item>
        <item name="android:background">@drawable/selector_chip</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:singleLine">true</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="Widget.YouTube2026.SeekBar" parent="@android:style/Widget.Holo.SeekBar">
        <item name="android:progressDrawable">@drawable/seekbar_progress</item>
        <item name="android:thumb">@drawable/seekbar_thumb</item>
        <item name="android:minHeight">@dimen/seekbar_height</item>
        <item name="android:maxHeight">@dimen/seekbar_height</item>
        <item name="android:thumbOffset">6dp</item>
    </style>

    <!-- ================= TEXT APPEARANCES ================= -->
    <style name="TextAppearance.YouTube2026.Headline" parent="@android:style/TextAppearance">
        <item name="android:textSize">@dimen/text_headline</item>
        <item name="android:textColor">@color/yt_text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.YouTube2026.Title" parent="@android:style/TextAppearance">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textColor">@color/yt_text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.YouTube2026.Body" parent="@android:style/TextAppearance">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/yt_text_primary</item>
    </style>

    <style name="TextAppearance.YouTube2026.Meta" parent="@android:style/TextAppearance">
        <item name="android:textSize">@dimen/text_meta</item>
        <item name="android:textColor">@color/yt_text_secondary</item>
    </style>

    <style name="TextAppearance.YouTube2026.Caption" parent="@android:style/TextAppearance">
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textColor">@color/yt_text_secondary</item>
    </style>

    <style name="TextAppearance.YouTube2026.Badge" parent="@android:style/TextAppearance">
        <item name="android:textSize">@dimen/text_meta</item>
        <item name="android:textColor">@color/yt_text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

</resources>
